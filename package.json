{
  "name": "distribuidora-costa-sur",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "test": "npm run test --workspace backend",
    "e2e": "cypress run",
    "e2e:open": "cypress open",
    "lint": "npm run lint --workspace backend && npm run lint --workspace frontend",
    "format": "prettier --write .",
    "db:backup": "powershell -ExecutionPolicy Bypass -File scripts/backup.ps1",
    "db:restore": "powershell -ExecutionPolicy Bypass -File scripts/restore.ps1 -BackupFile"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cypress": "^13.17.0",
    "prettier": "^3.5.3"
  }
}
